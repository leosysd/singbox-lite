{
	"luci-app-singbox-lite": {
		"description": "Grant access to SingBox Lite",
		"read": {
			"file": {
				"/etc/init.d/sing-box": [ "exec" ],
				"/etc/init.d/mosdns": [ "exec" ],
				"/sbin/logread": [ "exec" ],
				"/etc/sing-box/config.json": [ "read" ],
				"/etc/sing-box/sing-box.log": [ "read" ],
				"/usr/bin/sing-box": [ "exec" ],
				"/usr/bin/sing-box-disable-dns-hijack": [ "exec" ],
				"/usr/share/singboxlite/prepare-mosdns-config.uc": [ "exec" ],
				"/usr/share/singboxlite/sing-box-disable-dns-hijack.sh": [ "read" ],
				"/usr/share/singboxlite/update-geosite-rules.sh": [ "exec" ],
				"/etc/sing-box/rule-set/*": [ "read" ],
				"/etc/mosdns/rule/*": [ "read" ],
				"/tmp/singboxlite-ruleset.log": [ "read" ],
				"/tmp/singboxlite-update.log": [ "read" ],
				"/tmp/singboxlite-check.log": [ "read" ],
				"/tmp/singboxlite-prepare.log": [ "read" ],
				"/tmp/singboxlite/*": [ "read" ]
			},
			"ubus": {
				"file": [ "read" ],
				"service": [ "list" ],
				"luci.singboxlite": [ "*" ]
			},
			"uci": [ "singboxlite" ]
		},
		"write": {
			"file": {
				"/etc/crontabs/root": [ "read", "write" ],
				"/etc/sing-box/config.json": [ "read", "write" ],
				"/etc/sing-box/config.json.bak-*": [ "read", "write" ],
				"/etc/sing-box/sing-box.log": [ "read", "write" ],
				"/etc/sing-box/rule-set/*": [ "read", "write" ],
				"/etc/mosdns/rule/*": [ "read", "write" ],
				"/usr/bin/sing-box-disable-dns-hijack": [ "read", "write" ],
				"/tmp/singboxlite-ruleset.log": [ "read", "write" ],
				"/tmp/singboxlite-update.log": [ "read", "write" ],
				"/tmp/singboxlite-check.log": [ "read", "write" ],
				"/tmp/singboxlite-prepare.log": [ "read", "write" ],
				"/tmp/singboxlite/*": [ "read", "write" ]
			},
			"ubus": {
				"file": [ "read", "write" ],
				"luci.singboxlite": [ "*" ]
			},
			"uci": [ "singboxlite" ]
		}
	}
}
