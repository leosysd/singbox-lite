#!/usr/bin/env ucode

'use strict';

import { readfile, writefile, stat, popen, mkdir } from 'fs';
import { cursor } from 'uci';

const uci = cursor();

const DEFAULT_CONFIG = '/etc/sing-box/config.json';
const DEFAULT_LOG = '/etc/sing-box/sing-box.log';
const DEFAULT_TEMP_DIR = '/etc/sing-box/singboxlite';
const LOCAL_TEMP = '/etc/sing-box/singboxlite/import-local.json';
const REMOTE_TEMP = '/etc/sing-box/singboxlite/import-remote.json';
const MOSDNS_TEMP = '/etc/sing-box/singboxlite/import-mosdns.json';
const SINGBOX_TEMP = '/etc/sing-box/singboxlite/import-singbox.json';
const SOURCE_CONFIG = '/etc/sing-box/singboxlite/source.json';
const ROLLBACK_BACKUP = '/etc/sing-box/singboxlite/rollback-config.json';
const OLD_SOURCE_CONFIG = '/etc/sing-box/singboxlite-source.json';
const OLD_LOCAL_TEMP = '/tmp/singboxlite/import-local.json';
const OLD_REMOTE_TEMP = '/tmp/singboxlite/import-remote.json';
const DNS_HIJACK_BIN = '/usr/bin/sing-box-disable-dns-hijack';
const DNS_HIJACK_TEMPLATE = '/usr/share/singboxlite/sing-box-disable-dns-hijack.sh';
const MOSDNS_PREPARE = '/usr/share/singboxlite/prepare-mosdns-config.uc';
const SINGBOX_PREPARE = '/usr/share/singboxlite/prepare-singbox-config.uc';
const RULESET_UPDATER = '/usr/share/singboxlite/update-geosite-rules.sh';
const RULESET_LOG = '/tmp/singboxlite-ruleset.log';
const CORE_UPDATER = '/usr/share/singboxlite/update-singbox-core.sh';

function trim_text(value) {
	return replace(value || '', /^\s+|\s+$/g, '');
}

function shellquote(value) {
	return "'" + replace(value || '', /'/g, "'\"'\"'") + "'";
}

function now_string() {
	let p = popen('date "+%Y-%m-%d %H:%M:%S" 2>/dev/null', 'r');
	if (!p)
		return '';

	let out = trim_text(p.read('all'));
	p.close();
	return out;
}

function stamp_string() {
	let p = popen('date "+%Y%m%d-%H%M%S" 2>/dev/null', 'r');
	if (!p)
		return 'unknown';

	let out = trim_text(p.read('all'));
	p.close();
	return out || 'unknown';
}

function exec_cmd(cmd) {
	let p = popen(cmd + ' 2>&1', 'r');
	if (!p)
		return { code: -1, stdout: 'failed to execute command' };

	let stdout = p.read('all') || '';
	let code = p.close();
	return { code: code, stdout: trim_text(stdout) };
}

function cfg(section, option, fallback) {
	let res = exec_cmd('uci -q get singboxlite.' + section + '.' + option);
	let value = res.code === 0 ? res.stdout : null;

	if (value == null || value === '')
		return fallback;

	return value;
}

function safe_path(value, fallback, pattern) {
	value = trim_text(value || '');
	if (value == '' || !match(value, pattern) || match(value, /(^|\/)\.\.?(\/|$)/))
		return fallback;
	return value;
}

function set_cfg(section, option, value) {
	uci.set('singboxlite', section, option, value || '');
	uci.commit('singboxlite');
}

function set_cfg_pending(section, option, value) {
	uci.set('singboxlite', section, option, value || '');
}

function config_path() {
	return safe_path(cfg('main', 'config_path', DEFAULT_CONFIG), DEFAULT_CONFIG, /^\/etc\/sing-box\/[^\n]+$/);
}

function log_path() {
	return safe_path(cfg('main', 'log_path', DEFAULT_LOG), DEFAULT_LOG, /^(\/etc\/sing-box\/|\/tmp\/singboxlite\/)[^\n]+$/);
}

function source_config_path() {
	return safe_path(cfg('main', 'source_path', SOURCE_CONFIG), SOURCE_CONFIG, /^\/etc\/sing-box\/[^\n]+$/);
}

function temp_dir() {
	return safe_path(cfg('main', 'temp_dir', DEFAULT_TEMP_DIR), DEFAULT_TEMP_DIR, /^\/etc\/sing-box\/[^\n]+$/);
}

function current_mode() {
	return cfg('main', 'mode', 'singbox_mosdns') == 'singbox_mosdns'
		? 'singbox_mosdns'
		: 'singbox_dns';
}

function mosdns_addr() {
	return cfg('dns', 'mosdns_addr', '127.0.0.1');
}

function mosdns_port() {
	return cfg('dns', 'mosdns_port', '5335');
}

function disable_dns_hijack() {
	return cfg('dns', 'disable_dns_hijack', '1') == '1';
}

function restart_mosdns_after_apply() {
	return cfg('dns', 'restart_mosdns_after_apply', '1') == '1';
}

function ensure_temp_dir() {
	let dir = temp_dir();
	if (stat(dir)?.type != 'directory')
		mkdir(dir, 0700);
	return dir;
}

function file_size(path) {
	let s = stat(path);
	return s?.size || 0;
}

function command_exists(path) {
	return stat(path)?.type == 'file';
}

function service_running(name) {
	let res = exec_cmd('/etc/init.d/' + name + ' status');
	return res.code === 0 && match(res.stdout, /running/i);
}

function singbox_version() {
	if (!command_exists('/usr/bin/sing-box'))
		return '';

	let res = exec_cmd('/usr/bin/sing-box version | head -n 1');
	return res.stdout || '';
}

function singbox_pid() {
	let res = exec_cmd('pidof sing-box');
	if (res.code !== 0)
		return '';
	return res.stdout || '';
}

function clash_api_info() {
	let fallback = {
		external_controller: '',
		external_ui: '',
		secret: ''
	};
	let content = readfile(config_path());
	if (!content)
		return fallback;

	let config = null;
	try {
		config = json(content);
	} catch (e) {
		return fallback;
	}

	if (type(config) != 'object' || type(config.experimental) != 'object' || type(config.experimental.clash_api) != 'object')
		return fallback;

	let api = config.experimental.clash_api;
	return {
		external_controller: api.external_controller || '',
		external_ui: api.external_ui || '',
		secret: api.secret || ''
	};
}

function validate_json_file(path) {
	if (stat(path)?.type != 'file')
		return { ok: false, output: '文件不存在：' + path };

	if (file_size(path) <= 0)
		return { ok: false, output: '文件为空：' + path };

	let content = readfile(path);
	if (!content)
		return { ok: false, output: '无法读取文件：' + path };

	let parsed = null;
	try {
		parsed = json(content);
	} catch (e) {
		return { ok: false, output: 'JSON 格式错误：' + e };
	}

	if (type(parsed) != 'object')
		return { ok: false, output: 'JSON 顶层必须是对象' };

	return { ok: true, output: 'JSON 格式正确' };
}

function check_file(path) {
	let basic = validate_json_file(path);
	if (!basic.ok)
		return basic;

	if (!command_exists('/usr/bin/sing-box'))
		return { ok: false, output: '未找到 /usr/bin/sing-box' };

	let res = exec_cmd('/usr/bin/sing-box check -c ' + shellquote(path));
	return { ok: res.code === 0, output: res.stdout };
}

function format_config_file(path) {
	if (!command_exists('/usr/bin/sing-box'))
		return { ok: false, output: '未找到 /usr/bin/sing-box' };

	let res = exec_cmd('/usr/bin/sing-box format -w -c ' + shellquote(path));
	return { ok: res.code === 0, output: res.stdout || '已使用 sing-box format 格式化配置' };
}

function imported_path(source) {
	return source == 'remote' ? REMOTE_TEMP : LOCAL_TEMP;
}

function backup_current() {
	let current = config_path();
	if (stat(current)?.type != 'file')
		return { ok: true, skipped: true, output: '当前配置不存在，跳过备份：' + current, backup: '' };

	let backup = current + '.bak-singboxlite';
	let res = exec_cmd('rm -f ' + shellquote(current + '.bak-singboxlite-') + '* 2>/dev/null || true; cp -p ' + shellquote(current) + ' ' + shellquote(backup));
	return { ok: res.code === 0, output: res.stdout, backup: backup };
}

function backup_for_apply() {
	let current = config_path();
	if (stat(current)?.type != 'file')
		return { ok: true, skipped: true, output: '当前配置不存在，跳过回滚备份：' + current, backup: '' };

	ensure_temp_dir();
	let res = exec_cmd('cp -p ' + shellquote(current) + ' ' + shellquote(ROLLBACK_BACKUP));
	return { ok: res.code === 0, output: res.stdout || '已创建临时回滚备份', backup: ROLLBACK_BACKUP };
}

function cleanup_apply_backup() {
	let res = exec_cmd('rm -f ' + shellquote(ROLLBACK_BACKUP));
	return { ok: res.code === 0, output: res.stdout || '已清理临时回滚备份' };
}

function procd_service_not_found(res) {
	return res && res.code !== 0
		&& match(res.stdout || '', /ubus call service delete/)
		&& match(res.stdout || '', /\(Not found\)/);
}

function restart_singbox_internal() {
	if (stat('/etc/init.d/sing-box')?.type != 'file')
		return { ok: false, output: '未找到 /etc/init.d/sing-box' };

	let stopped = exec_cmd('/etc/init.d/sing-box stop');
	if (stopped.code !== 0 && !procd_service_not_found(stopped))
		return { ok: false, output: stopped.stdout };

	exec_cmd('sleep 1');

	let started = exec_cmd('/etc/init.d/sing-box start');
	if (started.code !== 0)
		return { ok: false, output: trim_text((procd_service_not_found(stopped) ? '' : stopped.stdout || '') + '\n' + (started.stdout || '')) };

	exec_cmd('sleep 2');

	let status = exec_cmd('/etc/init.d/sing-box status');
	if (status.code !== 0 || !match(status.stdout, /running/i))
		return { ok: false, output: trim_text((started.stdout || '') + '\n' + (status.stdout || 'sing-box 重启后未保持运行')) };

	return { ok: true, output: started.stdout || 'sing-box 已重启' };
}

function wait_seconds(seconds) {
	exec_cmd('sleep ' + int(seconds || 1));
}

function start_singbox_internal() {
	if (stat('/etc/init.d/sing-box')?.type != 'file')
		return { ok: false, output: '未找到 /etc/init.d/sing-box' };

	let res = exec_cmd('/etc/init.d/sing-box start');
	if (res.code !== 0)
		return { ok: false, output: res.stdout };

	exec_cmd('sleep 2');

	let status = exec_cmd('/etc/init.d/sing-box status');
	if (status.code !== 0 || !match(status.stdout, /running/i))
		return { ok: false, output: trim_text((res.stdout || '') + '\n' + (status.stdout || 'sing-box 启动后未保持运行')) };

	return { ok: true, output: res.stdout || 'sing-box 已启动' };
}

function stop_singbox_internal() {
	if (stat('/etc/init.d/sing-box')?.type != 'file')
		return { ok: false, output: '未找到 /etc/init.d/sing-box' };

	let res = exec_cmd('/etc/init.d/sing-box stop');
	if (procd_service_not_found(res))
		return { ok: true, output: 'sing-box 已停止' };

	return { ok: res.code === 0, output: res.stdout || 'sing-box 已停止' };
}

function stop_singbox_for_apply() {
	if (stat('/etc/init.d/sing-box')?.type != 'file')
		return { ok: false, output: '未找到 /etc/init.d/sing-box' };

	let res = exec_cmd('/etc/init.d/sing-box stop');
	if (res.code !== 0 && !procd_service_not_found(res))
		return { ok: false, output: res.stdout };

	wait_seconds(1);

	let status = exec_cmd('/etc/init.d/sing-box status');
	if (status.code === 0 && match(status.stdout, /running/i))
		return { ok: false, output: status.stdout || 'sing-box 停止后仍在运行' };

	return { ok: true, output: res.stdout || 'sing-box 已停止' };
}

function restart_mosdns_internal() {
	if (stat('/etc/init.d/mosdns')?.type != 'file')
		return { ok: false, output: '未找到 /etc/init.d/mosdns' };

	uci.set('mosdns', 'config', 'enabled', '1');
	uci.set('mosdns', 'config', 'redirect', '1');
	uci.set('mosdns', 'config', 'local_dns_redirect', '0');
	uci.commit('mosdns');
	let res = exec_cmd('/etc/init.d/mosdns restart');
	return { ok: res.code === 0, output: res.stdout };
}

function start_mosdns_for_apply() {
	if (stat('/etc/init.d/mosdns')?.type != 'file')
		return { ok: false, output: '未找到 /etc/init.d/mosdns' };

	uci.set('mosdns', 'config', 'enabled', '1');
	uci.set('mosdns', 'config', 'redirect', '1');
	uci.set('mosdns', 'config', 'local_dns_redirect', '0');
	uci.commit('mosdns');

	let action = restart_mosdns_after_apply() ? 'restart' : 'start';
	let res = exec_cmd('/etc/init.d/mosdns ' + action);
	if (res.code !== 0)
		return { ok: false, output: res.stdout };

	wait_seconds(10);

	let status = exec_cmd('/etc/init.d/mosdns status');
	if (status.code !== 0 || !match(status.stdout, /running/i))
		return { ok: false, output: trim_text((res.stdout || '') + '\n' + (status.stdout || 'MosDNS 启动后未保持运行')) };

	return { ok: true, output: res.stdout || (action == 'restart' ? 'MosDNS 已重启' : 'MosDNS 已启动') };
}

function enable_mosdns_internal() {
	if (stat('/etc/init.d/mosdns')?.type != 'file')
		return { ok: false, output: '未找到 /etc/init.d/mosdns' };

	let res = exec_cmd("uci -q set mosdns.config.enabled='1'; uci -q set mosdns.config.redirect='1'; uci -q set mosdns.config.local_dns_redirect='0'; uci -q commit mosdns");
	return { ok: res.code === 0, output: res.stdout || '已启用 MosDNS 与 DNS 转发' };
}

function stop_mosdns_internal() {
	if (stat('/etc/init.d/mosdns')?.type != 'file')
		return { ok: true, skipped: true, output: '未找到 /etc/init.d/mosdns' };

	let res = exec_cmd("uci -q set mosdns.config.redirect='0'; uci -q set mosdns.config.local_dns_redirect='0'; uci -q set mosdns.config.enabled='0'; uci -q commit mosdns; /etc/init.d/mosdns stop");
	if (res.code !== 0)
		return { ok: false, output: res.stdout };

	wait_seconds(1);

	let status = exec_cmd('/etc/init.d/mosdns status');
	if (status.code === 0 && match(status.stdout, /running/i))
		return { ok: false, output: status.stdout || 'MosDNS 停止后仍在运行' };

	return { ok: true, output: res.stdout || 'MosDNS 已停止' };
}

function cleanup_dnsmasq_mosdns_upstream() {
	let port = mosdns_port();
	let servers = [
		mosdns_addr() + '#' + port,
		'127.0.0.1#' + port,
		'::1#' + port,
		'localhost#' + port
	];
	let cmd = '';

	for (let i = 0; i < length(servers); i++)
		cmd += 'uci -q del_list dhcp.@dnsmasq[0].server=' + shellquote(servers[i]) + ' 2>/dev/null || true; ';

	cmd += "uci -q set dhcp.@dnsmasq[0].noresolv='0'; uci -q commit dhcp; /etc/init.d/dnsmasq restart";
	let res = exec_cmd(cmd);
	return { ok: res.code === 0, output: res.stdout || '已清理 dnsmasq MosDNS 上游并重启 dnsmasq' };
}

function dns_lookup_probe(target, label) {
	let res = exec_cmd('nslookup github.com ' + shellquote(target));
	if (res.code === 0 && match(res.stdout, /Address/))
		return { ok: true, output: label + ' DNS 探测通过', target: target, detail: res.stdout };

	return { ok: false, output: label + ' DNS 探测失败：github.com 无法解析\n' + (res.stdout || ''), target: target };
}

function dns_probe_for_apply(mode) {
	if (mode == 'singbox_mosdns') {
		let mosdns = dns_lookup_probe('127.0.0.1:' + mosdns_port(), 'MosDNS');
		if (!mosdns.ok)
			return mosdns;

		let system_dns = dns_lookup_probe('127.0.0.1', '本机入口');
		if (!system_dns.ok)
			return system_dns;

		return {
			ok: true,
			output: 'DNS 探测通过：MosDNS 与本机 DNS 入口均可解析 github.com',
			mosdns: mosdns,
			system_dns: system_dns
		};
	}

	return dns_lookup_probe('127.0.0.1', 'sing-box');
}

function rollback_after_failed_apply(backup, failed) {
	let dest = config_path();
	let restored = { ok: true, skipped: true };

	if (backup && stat(backup)?.type == 'file') {
		let res = exec_cmd('cp -p ' + shellquote(backup) + ' ' + shellquote(dest));
		restored = { ok: res.code === 0, output: res.stdout || '已恢复旧 sing-box 配置', backup: backup };
	}

	set_cfg('main', 'mode', 'singbox_dns');
	uninstall_dns_hijack_script();
	let mosdns = stop_mosdns_internal();
	let dnsmasq = cleanup_dnsmasq_mosdns_upstream();
	let singbox = start_singbox_internal();

	return {
		ok: false,
		output: trim_text((failed?.output || '应用后 DNS 探测失败') + '\n已回滚到 sing-box 模式，避免继续断网。'),
		restored: restored,
		mosdns: mosdns,
		dnsmasq: dnsmasq,
		singbox: singbox
	};
}

function rollback_step(step, backup, failed) {
	let rollback = rollback_after_failed_apply(backup, failed);
	return {
		ok: false,
		step: step,
		output: rollback.output,
		backup: backup,
		mode: 'singbox_dns',
		rollback: rollback
	};
}

function install_dns_hijack_script() {
	if (stat(DNS_HIJACK_BIN)?.type == 'file')
		return { ok: true, skipped: true, output: 'DNS DNAT 清理脚本已安装' };

	if (stat(DNS_HIJACK_TEMPLATE)?.type != 'file')
		return { ok: false, output: '缺少模板脚本：' + DNS_HIJACK_TEMPLATE };

	let res = exec_cmd('cp ' + shellquote(DNS_HIJACK_TEMPLATE) + ' ' + shellquote(DNS_HIJACK_BIN) + ' && chmod 0755 ' + shellquote(DNS_HIJACK_BIN));
	return { ok: res.code === 0, output: res.stdout || '已安装 DNS DNAT 清理脚本' };
}

function uninstall_dns_hijack_script() {
	if (stat(DNS_HIJACK_BIN)?.type != 'file')
		return { ok: true, skipped: true, output: 'DNS DNAT 清理脚本未安装' };

	let res = exec_cmd('rm -f ' + shellquote(DNS_HIJACK_BIN));
	return { ok: res.code === 0, output: res.stdout || '已卸载 DNS DNAT 清理脚本' };
}

function run_dns_hijack_script() {
	if (stat(DNS_HIJACK_BIN)?.type != 'file')
		return { ok: true, skipped: true, output: 'DNS DNAT 清理脚本未安装' };

	let res = exec_cmd(shellquote(DNS_HIJACK_BIN));
	return { ok: res.code === 0, output: res.stdout || '已清理 sing-box 自动生成的 53 端口 DNS DNAT' };
}

function prepare_mosdns_config(source) {
	ensure_temp_dir();

	if (stat(MOSDNS_PREPARE)?.type != 'file')
		return { ok: false, output: '缺少 MosDNS 配置处理脚本：' + MOSDNS_PREPARE };

	let res = exec_cmd(shellquote(MOSDNS_PREPARE) + ' ' + shellquote(source) + ' ' + shellquote(MOSDNS_TEMP) + ' ' + shellquote(mosdns_addr()) + ' ' + shellquote(mosdns_port()));
	if (res.code !== 0)
		return { ok: false, output: res.stdout };

	let formatted = format_config_file(MOSDNS_TEMP);
	if (!formatted.ok)
		return formatted;

	return { ok: true, path: MOSDNS_TEMP, output: '已生成 MosDNS 模式配置：' + MOSDNS_TEMP };
}

function prepare_singbox_config(source) {
	ensure_temp_dir();

	if (stat(SINGBOX_PREPARE)?.type != 'file')
		return { ok: false, output: '缺少 sing-box 配置处理脚本：' + SINGBOX_PREPARE };

	let res = exec_cmd(shellquote(SINGBOX_PREPARE) + ' ' + shellquote(source) + ' ' + shellquote(SINGBOX_TEMP));
	if (res.code !== 0)
		return { ok: false, output: res.stdout };

	let formatted = format_config_file(SINGBOX_TEMP);
	if (!formatted.ok)
		return formatted;

	return { ok: true, path: SINGBOX_TEMP, output: '已生成 sing-box 模式配置：' + SINGBOX_TEMP };
}

function check_for_mode(path) {
	if (current_mode() != 'singbox_mosdns') {
		let prepared = prepare_singbox_config(path);
		if (!prepared.ok)
			return prepared;

		let checked = check_file(prepared.path);
		checked.prepared_path = prepared.path;
		return checked;
	}

	let prepared = prepare_mosdns_config(path);
	if (!prepared.ok)
		return prepared;

	let checked = check_file(prepared.path);
	checked.prepared_path = prepared.path;
	return checked;
}

function store_source_config(path, source) {
	if (source != 'local' && source != 'remote')
		return { ok: true, skipped: true };

	let dest = source_config_path();
	exec_cmd('mkdir -p ' + shellquote(replace(dest, /\/[^\/]+$/, '')));

	let res = exec_cmd('cp -p ' + shellquote(path) + ' ' + shellquote(dest));
	if (res.code !== 0)
		return { ok: false, output: res.stdout };

	set_cfg('main', 'source_path', dest);
	return { ok: true, output: '已保存原始 JSON：' + dest, path: dest };
}

function current_source_path() {
	let source = source_config_path();

	if (stat(source)?.type == 'file')
		return source;
	if (stat(OLD_SOURCE_CONFIG)?.type == 'file')
		return OLD_SOURCE_CONFIG;
	if (stat(REMOTE_TEMP)?.type == 'file')
		return REMOTE_TEMP;
	if (stat(OLD_REMOTE_TEMP)?.type == 'file')
		return OLD_REMOTE_TEMP;

	return config_path();
}

function cleanup_stage_files() {
	let res = exec_cmd('rm -f ' + shellquote(LOCAL_TEMP) + ' ' + shellquote(REMOTE_TEMP) + ' ' + shellquote(MOSDNS_TEMP) + ' ' + shellquote(SINGBOX_TEMP) + ' 2>/dev/null || true; rm -rf /tmp/singboxlite 2>/dev/null || true');
	return { ok: res.code === 0, output: res.stdout || '已清理临时导入文件' };
}

function apply_config(path, source) {
	let mode = current_mode();
	let prepared = null;
	let apply_path = path;
	let checked = null;
	let backup = null;

	if (mode == 'singbox_mosdns') {
		prepared = prepare_mosdns_config(path);
		if (!prepared.ok)
			return { ok: false, step: 'prepare', output: prepared.output };

		apply_path = prepared.path;
	} else {
		prepared = prepare_singbox_config(path);
		if (!prepared.ok)
			return { ok: false, step: 'prepare', output: prepared.output };

		apply_path = prepared.path;
	}

	checked = check_file(apply_path);

	if (!checked.ok)
		return { ok: false, step: 'check', output: checked.output };

	let source_store = store_source_config(path, source);
	if (!source_store.ok)
		return { ok: false, step: 'source_store', output: source_store.output };

	backup = backup_for_apply();
	if (!backup.ok)
		return { ok: false, step: 'backup', output: backup.output };

	let stopped = stop_singbox_for_apply();
	if (!stopped.ok)
		return { ok: false, step: 'stop_singbox', output: stopped.output };

	let script = mode == 'singbox_mosdns' && disable_dns_hijack()
		? install_dns_hijack_script()
		: uninstall_dns_hijack_script();
	if (!script.ok)
		return rollback_step('dns_hijack_script', backup.backup, script);

	let mosdns = mode == 'singbox_dns' ? stop_mosdns_internal() : { ok: true, skipped: true };
	if (!mosdns.ok)
		return rollback_step('mosdns', backup.backup, mosdns);

	let dnsmasq = mode == 'singbox_dns' ? cleanup_dnsmasq_mosdns_upstream() : { ok: true, skipped: true };
	if (!dnsmasq.ok)
		return rollback_step('dnsmasq', backup.backup, dnsmasq);

	let mosdns_enable = mode == 'singbox_mosdns' ? enable_mosdns_internal() : { ok: true, skipped: true };
	if (!mosdns_enable.ok)
		return rollback_step('mosdns_enable', backup.backup, mosdns_enable);

	let dest = config_path();
	exec_cmd('mkdir -p ' + shellquote(replace(dest, /\/[^\/]+$/, '')));
	let copied = exec_cmd('cp ' + shellquote(apply_path) + ' ' + shellquote(dest));
	if (copied.code !== 0)
		return rollback_step('copy', backup.backup, { ok: false, output: copied.stdout || '复制配置失败' });

	let mosdns_after = mode == 'singbox_mosdns'
		? start_mosdns_for_apply()
		: { ok: true, skipped: true };
	if (!mosdns_after.ok)
		return rollback_step('mosdns_after_apply', backup.backup, mosdns_after);

	let restarted = start_singbox_internal();
	let dns_hijack_cleanup = mode == 'singbox_mosdns' && disable_dns_hijack() && restarted.ok
		? run_dns_hijack_script()
		: { ok: true, skipped: true };
	if (!dns_hijack_cleanup.ok)
		return rollback_step('dns_hijack_cleanup', backup.backup, dns_hijack_cleanup);

	let dns_probe = restarted.ok ? dns_probe_for_apply(mode) : { ok: false, output: restarted.output || 'sing-box 未启动，跳过 DNS 探测' };
	if (!dns_probe.ok) {
		let failed = rollback_step('dns_probe', backup.backup, dns_probe);
		failed.dns_probe = dns_probe;
		return failed;
	}

	let cleanup = restarted.ok ? cleanup_stage_files() : { ok: true, skipped: true };
	let backup_cleanup = restarted.ok ? cleanup_apply_backup() : { ok: true, skipped: true };

	set_cfg('main', 'last_apply_time', now_string());
	set_cfg('main', 'last_import_source', source || '');

	return {
		ok: restarted.ok && cleanup.ok && mosdns_after.ok && dns_hijack_cleanup.ok,
		step: 'restart',
		output: restarted.output || (mode == 'singbox_mosdns' ? '已应用 MosDNS 模式配置' : '已应用 sing-box 模式配置'),
		backup: backup.backup,
		mode: mode,
		prepared_path: prepared?.path || '',
		source_store: source_store,
		script: script,
		dnsmasq: dnsmasq,
		mosdns: mosdns,
		mosdns_enable: mosdns_enable,
		mosdns_after: mosdns_after,
		stopped: stopped,
		dns_hijack_cleanup: dns_hijack_cleanup,
		dns_probe: dns_probe,
		stage_cleanup: cleanup,
		backup_cleanup: backup_cleanup
	};
}

function apply_imported(source) {
	return apply_config(imported_path(source), source);
}

function apply_current() {
	let path = current_source_path();

	if (path == REMOTE_TEMP)
		return apply_config(path, 'remote');
	if (path == LOCAL_TEMP)
		return apply_config(path, 'local');

	return apply_config(path, 'current');
}

function fetch_remote(url) {
	ensure_temp_dir();

	url = trim_text(url || cfg('remote', 'url', ''));
	if (url == '')
		return { ok: false, output: '远程 URL 不能为空' };

	let path = REMOTE_TEMP;
	let qurl = shellquote(url);
	let qpath = shellquote(path);
	let cmd = '';

	if (exec_cmd('command -v uclient-fetch').code === 0)
		cmd = 'uclient-fetch -T 30 -O ' + qpath + ' ' + qurl;
	else if (exec_cmd('command -v wget').code === 0)
		cmd = 'wget -T 30 -O ' + qpath + ' ' + qurl;
	else if (exec_cmd('command -v curl').code === 0)
		cmd = 'curl -L --connect-timeout 30 --max-time 30 -o ' + qpath + ' ' + qurl;
	else
		return { ok: false, output: '未找到 uclient-fetch、wget 或 curl' };

	let res = exec_cmd(cmd);
	if (res.code !== 0) {
		set_cfg('remote', 'last_update_result', 'fail');
		return { ok: false, output: res.stdout };
	}

	let content = readfile(path) || '';
	if (length(content) < 20) {
		set_cfg('remote', 'last_update_result', 'fail');
		return { ok: false, step: 'download', temp_path: path, output: '远程配置为空或内容异常' };
	}

	let config = null;
	try {
		config = json(content);
	} catch (e) {
		set_cfg('remote', 'last_update_result', 'fail');
		return { ok: false, step: 'json_check', temp_path: path, output: '远程配置不是有效 JSON：' + e };
	}

	if (type(config) != 'object') {
		set_cfg('remote', 'last_update_result', 'fail');
		return { ok: false, step: 'json_check', temp_path: path, output: '远程配置 JSON 顶层必须是对象' };
	}

	set_cfg('remote', 'url', url);
	set_cfg('remote', 'last_update_time', now_string());
	set_cfg('main', 'last_import_time', now_string());
	set_cfg('main', 'last_import_source', 'remote');

	let checked = check_for_mode(path);
	set_cfg('main', 'last_check_result', checked.ok ? 'pass' : 'fail');
	set_cfg('main', 'last_check_time', now_string());
	set_cfg('remote', 'last_update_result', checked.ok ? 'pass' : 'fail');

	if (checked.ok) {
		let stored = store_source_config(path, 'remote');
		if (!stored.ok)
			return { ok: false, temp_path: path, output: stored.output };
	}

	return {
		ok: checked.ok,
		step: checked.ok ? 'remote_check' : 'check',
		temp_path: path,
		prepared_path: checked.prepared_path || '',
		output: checked.ok
			? '远程配置拉取成功，JSON 有效，sing-box check 通过'
			: checked.output
	};
}

function tail_log(lines, filter) {
	let path = log_path();
	if (stat(path)?.type != 'file')
		return { ok: false, log: '', output: '日志文件不存在：' + path };

	lines = int(lines || cfg('log', 'tail_lines', '200')) || 200;
	if (lines < 1)
		lines = 200;
	if (lines > 2000)
		lines = 2000;

	let cmd = 'tail -n ' + lines + ' ' + shellquote(path);
	if (filter == 'ERROR' || filter == 'FATAL')
		cmd += ' | grep -a ' + shellquote(filter);

	let res = exec_cmd(cmd);
	return { ok: true, log: res.stdout, size: file_size(path) };
}

function tail_source_log(source, lines) {
	source = source || 'singbox';
	lines = int(lines || cfg('log', 'tail_lines', '200')) || 200;
	if (lines < 1)
		lines = 200;
	if (lines > 2000)
		lines = 2000;

	if (source == 'system') {
		let res = exec_cmd('logread 2>/dev/null | tail -n ' + lines);
		return { ok: res.code === 0, source: source, log: res.stdout, size: length(res.stdout || '') };
	}

	if (source == 'singbox') {
		let cmd = 'logread 2>/dev/null | grep -a ' + shellquote('sing-box') + ' | tail -n ' + lines;
		let res = exec_cmd(cmd);
		return {
			ok: res.code === 0 || res.code === 1,
			source: source,
			log: res.stdout,
			size: length(res.stdout || ''),
			output: res.stdout || '系统日志里暂无 sing-box 记录'
		};
	}

	if (source == 'app') {
		let cmd = 'for f in /tmp/singboxlite-core.log /tmp/singboxlite-ruleset.log /tmp/singboxlite-update.log /tmp/singboxlite-check.log /tmp/singboxlite-prepare.log; do [ -f "$f" ] && { echo "===== $f ====="; tail -n ' + lines + ' "$f"; }; done';
		let res = exec_cmd(cmd);
		return { ok: true, source: source, log: res.stdout, size: length(res.stdout || '') };
	}

	return tail_log(lines, '');
}

function cron_time(value, label) {
	value = trim_text(value || '');
	let parts = split(value, ':');

	if (length(parts) != 2 || !match(parts[0], /^[0-9]{1,2}$/) || !match(parts[1], /^[0-9]{1,2}$/))
		return { ok: false, output: label + ' 必须是 HH:MM 格式' };

	let hour = int(parts[0]);
	let min = int(parts[1]);

	if (hour < 0 || hour > 23 || min < 0 || min > 59)
		return { ok: false, output: label + ' 超出有效范围' };

	return { ok: true, hour: hour, min: min };
}

function set_cron() {
	let cron = '/etc/crontabs/root';
	let content = readfile(cron) || '';
	let original = content;
	let rows = split(content, '\n');
	let kept = [];

	for (let i = 0; i < length(rows); i++) {
		if (match(rows[i], /clear sing-box log daily/))
			continue;
		if (match(rows[i], /singboxlite remote config update/))
			continue;
		if (match(rows[i], /singboxlite ruleset update/))
			continue;
		if (match(rows[i], /\/usr\/bin\/update-geosite-rules[ \t]+update/))
			continue;
		if (match(rows[i], /\/usr\/share\/mosdns\/mosdns\.uc[ \t]+update/))
			continue;
		if (rows[i] != '' || i < length(rows) - 1)
			push(kept, rows[i]);
	}

	content = join('\n', kept);
	if (content != '')
		content += '\n';

	let ruleset_weekday = cfg('ruleset', 'update_weekday', '2');
	if (!match(ruleset_weekday, /^[0-6]$/))
		return { ok: false, output: '规则集更新星期必须是 0-6' };

	if (cfg('log', 'cleanup_enabled', '1') == '1') {
		let cleanup_time = cron_time(cfg('log', 'cleanup_time', '03:10'), '日志清理时间');
		if (!cleanup_time.ok)
			return cleanup_time;
		content += cleanup_time.min + ' ' + cleanup_time.hour + ' * * * /usr/bin/truncate -s 0 ' + shellquote(log_path()) + ' # clear sing-box log daily\n';
	}

	if (cfg('remote', 'auto_update', '0') == '1') {
		let remote_time = cron_time(cfg('remote', 'auto_update_time', '03:00'), '远程更新时间');
		if (!remote_time.ok)
			return remote_time;
		content += remote_time.min + ' ' + remote_time.hour + ' * * * /usr/share/singboxlite/auto-update.sh # singboxlite remote config update\n';
	}

	if (cfg('ruleset', 'auto_update', '1') == '1') {
		let ruleset_time = cron_time(cfg('ruleset', 'update_time', '07:45'), '规则集更新时间');
		if (!ruleset_time.ok)
			return ruleset_time;
		content += ruleset_time.min + ' ' + ruleset_time.hour + ' * * ' + ruleset_weekday + ' /usr/share/singboxlite/update-geosite-rules.sh update # singboxlite ruleset update\n';
	}

	let changed = content != original;

	if (changed) {
		writefile(cron, content);
		exec_cmd('/etc/init.d/cron restart');
	}

	return { ok: true, changed: changed };
}

function save_overview_settings(settings) {
	settings = type(settings) == 'object' ? settings : {};

	set_cfg_pending('main', 'mode', settings.mode == 'singbox_mosdns' ? 'singbox_mosdns' : 'singbox_dns');
	set_cfg_pending('main', 'config_path', safe_path(settings.config_path, DEFAULT_CONFIG, /^\/etc\/sing-box\/[^\n]+$/));
	set_cfg_pending('main', 'log_path', safe_path(settings.log_path, DEFAULT_LOG, /^(\/etc\/sing-box\/|\/tmp\/singboxlite\/)[^\n]+$/));
	set_cfg_pending('remote', 'url', trim_text(settings.remote_url || ''));
	set_cfg_pending('remote', 'auto_update', settings.remote_auto == '1' ? '1' : '0');
	set_cfg_pending('remote', 'auto_update_time', trim_text(settings.remote_time || cfg('remote', 'auto_update_time', '03:00')));
	set_cfg_pending('remote', 'auto_apply', settings.remote_apply == '1' ? '1' : '0');
	set_cfg_pending('dns', 'mosdns_addr', trim_text(settings.mosdns_addr || '127.0.0.1'));
	set_cfg_pending('dns', 'mosdns_port', trim_text(settings.mosdns_port || '5335'));
	set_cfg_pending('dns', 'disable_dns_hijack', settings.disable_dns_hijack == '1' ? '1' : '0');
	set_cfg_pending('dns', 'restart_mosdns_after_apply', settings.restart_mosdns == '1' ? '1' : '0');
	set_cfg_pending('log', 'cleanup_enabled', settings.clean_log == '1' ? '1' : '0');
	set_cfg_pending('log', 'tail_lines', trim_text(settings.tail_lines || '200'));

	uci.commit('singboxlite');

	return { ok: true, output: '已保存 SingBox Lite 设置' };
}

function backup_glob() {
	return shellquote(config_path() + '.bak-singboxlite') + '*';
}

function list_backups() {
	let res = exec_cmd('ls -1 ' + backup_glob());
	if (res.code !== 0 || res.stdout == '')
		return [];

	return split(res.stdout, '\n');
}

function delete_backups() {
	let backups = list_backups();
	let res = exec_cmd('rm -f ' + backup_glob());
	return {
		ok: res.code === 0,
		output: res.code === 0 ? '已删除 ' + length(backups) + ' 个备份' : res.stdout,
		deleted: length(backups)
	};
}

function update_ruleset() {
	if (stat(RULESET_UPDATER)?.type != 'file')
		return { ok: false, output: '缺少规则集更新脚本：' + RULESET_UPDATER };

	let res = exec_cmd(shellquote(RULESET_UPDATER) + ' update');
	set_cfg('ruleset', 'last_update_time', now_string());
	set_cfg('ruleset', 'last_update_result', res.code === 0 ? 'pass' : 'fail');

	return {
		ok: res.code === 0,
		output: res.stdout || (res.code === 0 ? '规则集更新完成' : '规则集更新失败')
	};
}

function ruleset_status() {
	if (stat(RULESET_UPDATER)?.type != 'file')
		return { ok: false, output: '缺少规则集更新脚本：' + RULESET_UPDATER };

	let res = exec_cmd(shellquote(RULESET_UPDATER) + ' status');
	return { ok: res.code === 0, output: res.stdout };
}

function clear_ruleset_log() {
	let res = exec_cmd(shellquote(RULESET_UPDATER) + ' clear-log');
	return { ok: res.code === 0, output: res.stdout || '规则集更新日志已清理' };
}

function core_include_arg(include_prerelease) {
	return include_prerelease == '1' || include_prerelease == true ? '1' : '0';
}

function check_core_update(include_prerelease) {
	if (stat(CORE_UPDATER)?.type != 'file')
		return { ok: false, output: '缺少核心更新脚本：' + CORE_UPDATER };

	let include = core_include_arg(include_prerelease);
	let res = exec_cmd(shellquote(CORE_UPDATER) + ' check ' + include);
	return {
		ok: res.code === 0,
		output: res.stdout || (res.code === 0 ? '核心更新检查完成' : '核心更新检查失败'),
		current_version: singbox_version(),
		latest_version: cfg('core', 'latest_version', ''),
		last_check_time: cfg('core', 'last_check_time', ''),
		last_check_result: cfg('core', 'last_check_result', ''),
		arch: cfg('core', 'arch', ''),
		download_url: cfg('core', 'download_url', '')
	};
}

function update_core(include_prerelease) {
	if (stat(CORE_UPDATER)?.type != 'file')
		return { ok: false, output: '缺少核心更新脚本：' + CORE_UPDATER };

	let include = core_include_arg(include_prerelease);
	let res = exec_cmd(shellquote(CORE_UPDATER) + ' update ' + include);
	return {
		ok: res.code === 0,
		output: res.stdout || (res.code === 0 ? '核心更新完成' : '核心更新失败'),
		current_version: singbox_version(),
		latest_version: cfg('core', 'latest_version', ''),
		last_update_time: cfg('core', 'last_update_time', ''),
		last_update_result: cfg('core', 'last_update_result', ''),
		arch: cfg('core', 'arch', ''),
		download_url: cfg('core', 'download_url', '')
	};
}

const methods = {
	status: {
		call: function() {
			let log = log_path();
			let clash = clash_api_info();
			return {
				singbox_installed: command_exists('/usr/bin/sing-box'),
				singbox_running: !!service_running('sing-box'),
				singbox_version: singbox_version(),
				singbox_pid: singbox_pid(),
				mosdns_installed: command_exists('/etc/init.d/mosdns'),
				mosdns_running: !!service_running('mosdns'),
				config_path: config_path(),
				log_path: log,
				log_size: file_size(log),
				mode: current_mode(),
				dns_hijack_script_installed: command_exists(DNS_HIJACK_BIN),
				backup_count: length(list_backups()),
				last_check_result: cfg('main', 'last_check_result', ''),
				last_check_time: cfg('main', 'last_check_time', ''),
				last_apply_time: cfg('main', 'last_apply_time', ''),
				remote_url: cfg('remote', 'url', ''),
				mosdns_addr: mosdns_addr(),
				mosdns_port: mosdns_port(),
				ruleset_singbox_dir: safe_path(cfg('ruleset', 'singbox_dir', '/etc/sing-box/rule-set'), '/etc/sing-box/rule-set', /^\/etc\/sing-box\/[^\n]+$/),
				ruleset_mosdns_dir: safe_path(cfg('ruleset', 'mosdns_dir', '/etc/mosdns/rule'), '/etc/mosdns/rule', /^\/etc\/mosdns\/[^\n]+$/),
				ruleset_last_update_time: cfg('ruleset', 'last_update_time', ''),
				ruleset_last_update_result: cfg('ruleset', 'last_update_result', ''),
				core_include_prerelease: cfg('core', 'include_prerelease', ''),
				core_latest_version: cfg('core', 'latest_version', ''),
				core_last_check_time: cfg('core', 'last_check_time', ''),
				core_last_check_result: cfg('core', 'last_check_result', ''),
				core_last_update_time: cfg('core', 'last_update_time', ''),
				core_last_update_result: cfg('core', 'last_update_result', ''),
				core_arch: cfg('core', 'arch', ''),
				core_download_url: cfg('core', 'download_url', ''),
				clash_api_external_controller: clash.external_controller,
				clash_api_external_ui: clash.external_ui,
				clash_api_secret: clash.secret
			};
		}
	},

	check_current: {
		call: function() {
			let res = check_file(config_path());
			set_cfg('main', 'last_check_result', res.ok ? 'pass' : 'fail');
			set_cfg('main', 'last_check_time', now_string());
			return res;
		}
	},

	check_imported: {
		args: { source: 'local' },
		call: function(request) {
			let source = request.args?.source || 'local';
			let res = check_for_mode(imported_path(source));
			set_cfg('main', 'last_check_result', res.ok ? 'pass' : 'fail');
			set_cfg('main', 'last_check_time', now_string());
			return res;
		}
	},

	fetch_remote: {
		args: { url: '' },
		call: function(request) {
			return fetch_remote(request.args?.url);
		}
	},

	apply_imported: {
		args: { source: 'local' },
		call: function(request) {
			return apply_imported(request.args?.source || 'local');
		}
	},

	apply_current: {
		call: function() {
			return apply_current();
		}
	},

	save_overview_settings: {
		args: { settings: {} },
		call: function(request) {
			return save_overview_settings(request.args?.settings);
		}
	},

	backup_current: {
		call: function() {
			return backup_current();
		}
	},

	delete_backups: {
		call: function() {
			return delete_backups();
		}
	},

	update_ruleset: {
		call: function() {
			return update_ruleset();
		}
	},

	ruleset_status: {
		call: function() {
			return ruleset_status();
		}
	},

	clear_ruleset_log: {
		call: function() {
			return clear_ruleset_log();
		}
	},

	check_core_update: {
		args: { include_prerelease: '0' },
		call: function(request) {
			return check_core_update(request.args?.include_prerelease);
		}
	},

	update_core: {
		args: { include_prerelease: '0' },
		call: function(request) {
			return update_core(request.args?.include_prerelease);
		}
	},

	restart_singbox: {
		call: function() {
			return restart_singbox_internal();
		}
	},

	start_singbox: {
		call: function() {
			return start_singbox_internal();
		}
	},

	stop_singbox: {
		call: function() {
			return stop_singbox_internal();
		}
	},

	restart_mosdns: {
		call: function() {
			return restart_mosdns_internal();
		}
	},

	clean_log: {
		call: function() {
			let path = log_path();
			writefile(path, '');
			return { ok: true, output: '日志已清理' };
		}
	},

	tail_log: {
		args: { lines: 200, filter: '' },
		call: function(request) {
			return tail_log(request.args?.lines, request.args?.filter);
		}
	},

	tail_source_log: {
		args: { source: 'singbox', lines: 200 },
		call: function(request) {
			return tail_source_log(request.args?.source || 'singbox', request.args?.lines || 200);
		}
	},

	set_cron: {
		call: function() {
			return set_cron();
		}
	}
};

return { 'luci.singboxlite': methods };
