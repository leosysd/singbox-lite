config main 'main'
	option enabled '1'
	option mode 'singbox_mosdns'
	option config_path '/etc/sing-box/config.json'
	option log_path '/etc/sing-box/sing-box.log'
	option temp_dir '/etc/sing-box/singboxlite'
	option source_path '/etc/sing-box/singboxlite/source.json'
	option last_check_result ''
	option last_check_time ''
	option last_import_source ''
	option last_import_time ''
	option last_apply_time ''

config remote 'remote'
	option url ''
	option auto_update '0'
	option auto_update_time '03:00'
	option auto_apply '0'
	option last_update_time ''
	option last_update_result ''

config dns 'dns'
	option mosdns_addr '127.0.0.1'
	option mosdns_port '5335'
	option disable_dns_hijack '1'
	option restart_mosdns_after_apply '1'

config log 'log'
	option cleanup_enabled '1'
	option cleanup_time '03:10'
	option tail_lines '200'
	option auto_refresh '0'

config ruleset 'ruleset'
	option repo_raw 'https://raw.githubusercontent.com/leosysd/ruleset/main/dist'
	option singbox_dir '/etc/sing-box/rule-set'
	option mosdns_dir '/etc/mosdns/rule'
	option auto_update '1'
	option update_time '07:45'
	option update_weekday '2'
	option restart_singbox '0'
	option restart_mosdns '1'
	option last_update_time ''
	option last_update_result ''

config core 'core'
	option include_prerelease '0'
	option latest_version ''
	option last_check_time ''
	option last_check_result ''
	option last_update_time ''
	option last_update_result ''
	option arch ''
	option download_url ''

config app 'app'
	option current_version ''
	option latest_version ''
	option download_url ''
	option update_available ''
	option last_check_time ''
	option last_check_result ''
	option last_update_time ''
	option last_update_result ''
